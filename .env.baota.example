WEB_PORT=8111
SERVER_PORT=8080

DB_URL=jdbc:postgresql://<db-host>:5432/<db-name>?currentSchema=plm
DB_USERNAME=<db-username>
DB_PASSWORD=<db-password>

APP_SECURITY_ENABLED=true
APP_SECURITY_DEV_TOKEN=<replace-with-strong-token>
SPRING_DATASOURCE_HIKARI_CONNECTIONTIMEOUT=10000
SPRING_FLYWAY_CONNECT_RETRIES=3
SPRING_FLYWAY_CONNECT_RETRIES_INTERVAL=10s
SERVER_CPUS=1.0
JAVA_TOOL_OPTIONS=-XX:ActiveProcessorCount=1 -XX:MaxRAMPercentage=75.0

DINGTALK_MODEL_VARIANT_PROCESS_CODE=PROC-BD65F530-F66F-46B9-8F72-0567DD68F60C
DINGTALK_APP_KEY=<dingtalk-app-key>
DINGTALK_APP_SECRET=<dingtalk-app-secret>
DINGTALK_CALLBACK_TOKEN=<dingtalk-callback-token>
DINGTALK_AUTO_APPROVER_USER_ID=<dingtalk-user-id>
DINGTALK_PRODUCT_LINE_CC_USER_IDS=<comma-separated-dingtalk-user-ids>
DINGTALK_OUTBOUND_ENDPOINT=http://<server-host>:8111/api/v1/integrations/dingtalk/outbound
